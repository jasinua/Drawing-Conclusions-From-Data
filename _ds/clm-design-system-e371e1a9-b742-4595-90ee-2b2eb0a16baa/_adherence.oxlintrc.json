{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/display/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlay/**",
              "ui_kits/clm-admin/**",
              "ui_kits/signing-portal/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Lato))/i]",
        "message": "Font not provided by the design system. Available: Lato."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:user|tabs|activeTab|onTabChange|onUserMenu|style|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: user, tabs, activeTab, onTabChange, onUserMenu, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|loading|iconLeft|iconRight|iconOnly|asLink|fullWidth|align|icon|children|style|onClick|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, loading, iconLeft, iconRight, iconOnly, asLink, fullWidth, align, icon, children, style, onClick, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|primary-outline|primary-ghost|secondary|secondary-ghost|secondary-link|warning|warning-outline|warning-ghost|danger|danger-2|danger-outline|danger-ghost|success|success-2|success-outline|success-ghost|green|red|outline|ghost|link|destructive|destructive-outline|disabled)$/]",
        "message": "<Button> variant must be one of 'primary' | 'primary-outline' | 'primary-ghost' | 'secondary' | 'secondary-ghost' | 'secondary-link' | 'warning' | 'warning-outline' | 'warning-ghost' | 'danger' | 'danger-2' | 'danger-outline' | 'danger-ghost' | 'success' | 'success-2' | 'success-outline' | 'success-ghost' | 'green' | 'red' | 'outline' | 'ghost' | 'link' | 'destructive' | 'destructive-outline' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right|between)$/]",
        "message": "<Button> align must be one of 'left' | 'center' | 'right' | 'between'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|helpText|disabled|id|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, label, helpText, disabled, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmDeletePopup'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|itemType|itemName|selectedItem|customTitle|customMessage|loading|onCancel|onConfirm|key|ref|className|style|children)$/]",
        "message": "<ConfirmDeletePopup> doesn't accept that prop. Declared props: open, itemType, itemName, selectedItem, customTitle, customMessage, loading, onCancel, onConfirm."
      },
      {
        "selector": "JSXOpeningElement[name.name='CustomStatsCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|value|iconName|iconVariant|clickable|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CustomStatsCard> doesn't accept that prop. Declared props: title, value, iconName, iconVariant, clickable, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CustomStatsCard'] > JSXAttribute[name.name='iconVariant'] > Literal[value!=/^(?:primary|secondary|warning|danger|success|gray-blue|blue-light|blue|indigo|purple|pink|orange|light-orange)$/]",
        "message": "<CustomStatsCard> iconVariant must be one of 'primary' | 'secondary' | 'warning' | 'danger' | 'success' | 'gray-blue' | 'blue-light' | 'blue' | 'indigo' | 'purple' | 'pink' | 'orange' | 'light-orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateRangeInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|placeholder|onClear|onClick|style|key|ref|className|style|children)$/]",
        "message": "<DateRangeInput> doesn't accept that prop. Declared props: value, placeholder, onClear, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|isFilterOrSearchActive|action|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, description, isFilterOrSearchActive, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|stroke|width|height|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, stroke, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|required|placeholder|value|defaultValue|onChange|type|size|disabled|hasErrors|error|messages|helpText|prefixIcon|suffixIcon|prefix|prefixWidth|clearable|onClear|id|style|wrapperStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, required, placeholder, value, defaultValue, onChange, type, size, disabled, hasErrors, error, messages, helpText, prefixIcon, suffixIcon, prefix, prefixWidth, clearable, onClear, id, style, wrapperStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Input> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:item|title|subtitle|showDefaultFields|showActiveBadge|onDelete|right|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ListCard> doesn't accept that prop. Declared props: item, title, subtitle, showDefaultFields, showActiveBadge, onDelete, right, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|count|showMargin|actions|children|style|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: title, count, showMargin, actions, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaginationState'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|page_size|total_items|total_pages|key|ref|className|style|children)$/]",
        "message": "<PaginationState> doesn't accept that prop. Declared props: page, page_size, total_items, total_pages."
      },
      {
        "selector": "JSXOpeningElement[name.name='Popup'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|width|maxWidth|minHeight|title|header|children|actions|footer|onClose|closeOnOutside|style|contentStyle|key|ref|className|style|children)$/]",
        "message": "<Popup> doesn't accept that prop. Declared props: open, width, maxWidth, minHeight, title, header, children, actions, footer, onClose, closeOnOutside, style, contentStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchFilterBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:search|onSearchChange|placeholder|showStatusFilter|status|onStatusChange|statusLabels|filterTitle|showAddBtn|btnLabel|onCreate|disabled|children|style|key|ref|className|style|children)$/]",
        "message": "<SearchFilterBar> doesn't accept that prop. Declared props: search, onSearchChange, placeholder, showStatusFilter, status, onStatusChange, statusLabels, filterTitle, showAddBtn, btnLabel, onCreate, disabled, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|sublabel|disabled|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label, sublabel, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|route|svg|key|ref|className|style|children)$/]",
        "message": "<SidebarItem> doesn't accept that prop. Declared props: label, route, svg."
      },
      {
        "selector": "JSXOpeningElement[name.name='SideNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|to|options|expanded|key|ref|className|style|children)$/]",
        "message": "<SideNavItem> doesn't accept that prop. Declared props: label, icon, to, options, expanded."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatsCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|label|value|iconName|iconVariant|clickable|selected|onClick|bottom|tag|style|key|ref|className|style|children)$/]",
        "message": "<StatsCard> doesn't accept that prop. Declared props: title, label, value, iconName, iconVariant, clickable, selected, onClick, bottom, tag, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatsCard'] > JSXAttribute[name.name='iconVariant'] > Literal[value!=/^(?:primary|secondary|warning|danger|success|gray-blue|blue-light|blue|indigo|purple|pink|orange|light-orange)$/]",
        "message": "<StatsCard> iconVariant must be one of 'primary' | 'secondary' | 'warning' | 'danger' | 'success' | 'gray-blue' | 'blue-light' | 'blue' | 'indigo' | 'purple' | 'pink' | 'orange' | 'light-orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|sortable|render|width|align|key|ref|className|style|children)$/]",
        "message": "<TableColumn> doesn't accept that prop. Declared props: key, label, sortable, render, width, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<TableColumn> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|variant|color|iconLeft|iconRight|closable|onClose|isBadge|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: label, children, variant, color, iconLeft, iconRight, closable, onClose, isBadge, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:gray|brand|success|warning|error|purple)$/]",
        "message": "<Tag> color must be one of 'gray' | 'brand' | 'success' | 'warning' | 'error' | 'purple'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|title|message|onClose|duration|autoClose|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: type, title, message, onClose, duration, autoClose, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:|success|error|warning|info)$/]",
        "message": "<Toast> type must be one of '' | 'success' | 'error' | 'warning' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|size|disabled|label|labelSide|style|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, onChange, size, disabled, label, labelSide, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|medium|large)$/]",
        "message": "<Toggle> size must be one of 'small' | 'medium' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute[name.name='labelSide'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Toggle> labelSide must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UploadedFile'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|size|progress|file|key|ref|className|style|children)$/]",
        "message": "<UploadedFile> doesn't accept that prop. Declared props: id, name, size, progress, file."
      }
    ]
